{
  "name": "x09-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "X09 Docs — AI invoices, estimates, proposals and contracts on Cloudflare Workers + D1 + Stripe",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler d1 migrations apply x09-docs-db --remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply x09-docs-db --local",
    "db:migrate": "wrangler d1 migrations apply x09-docs-db --remote",
    "test": "node --experimental-sqlite --no-warnings test/api.test.mjs",
    "test:server": "node --experimental-sqlite --no-warnings test/dev-server.mjs",
    "build": "node scripts/setup-db.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
